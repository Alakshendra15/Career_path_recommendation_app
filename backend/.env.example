# Copy to .env and fill in. Never commit .env.
PORT=4000
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/career_path
# At least 16 random characters, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# FastAPI service (see ai-ml/)
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=20000
# Cached analysis lifetime. Cached results are also recomputed automatically when the ML service's knowledge base or model changes;
# ML_VERSION is only a manual extra salt for the cache key (bump it to force every user to be recomputed).
ANALYSIS_CACHE_DAYS=7
ML_VERSION=3
# Max login/signup requests per IP per 15 minutes
AUTH_RATE_LIMIT=20
# Per signed-in user, per 15 minutes (these routes call the ML service)
AI_RATE_LIMIT=60
RESUME_RATE_LIMIT=20
# Behind a reverse proxy set TRUST_PROXY=1 so rate limits see real client IPs. In production restrict browsers with CORS_ORIGINS=https://app.example.com
# TRUST_PROXY=1
# CORS_ORIGINS=
